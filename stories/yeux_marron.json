  "scenes": [
    { "text": "Avoir les yeux marron en 2026, c'est jouer à la vie en mode hardcore.",
      "bg": { "type": "split", "left": "#bfe3ff", "right": "#e8cfae" },
      "props": [ { "type": "eye_blue", "x": 34, "y": 70, "scale": 3, "anim": "float" },
                 { "type": "eye_brown", "x": 100, "y": 70, "scale": 3, "anim": "float" } ],
      "chars": [ { "id": "bleu", "x": 34, "expr": "smirk" },
                 { "id": "moi", "x": 100, "expr": "worried", "flip": true } ],
      "fx": ["flash"] },

    { "title": "+1000 aura", "title_color": "#5ee07a",
      "text": "Le gars aux yeux bleus, il cligne des yeux : plus mille aura.",
      "bg": { "type": "burst", "color": "#bfe3ff", "color2": "#9fd0fa" },
      "chars": [ { "id": "bleu", "x": 67, "expr": "smirk", "anim": "bounce" } ],
      "props": [ { "type": "star", "x": 24, "y": 110, "anim": "float" },
                 { "type": "star", "x": 110, "y": 100, "anim": "float" } ] },

    { "title": "-500 aura", "title_color": "#ff5a5a",
      "text": "Moi je cligne des yeux : on me demande si j'suis fatigué.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "neutral", "bubble": "zzz" } ] },

    { "text": "Les yeux bleus, on leur dit : t'as les yeux de l'océan.",
      "bg": { "type": "burst", "color": "#ffd6e0", "color2": "#ffc2d1" },
      "chars": [ { "id": "fille", "x": 40, "expr": "love" },
                 { "id": "bleu", "x": 98, "expr": "smirk", "flip": true } ],
      "props": [ { "type": "heart", "x": 67, "y": 70, "scale": 2, "anim": "float" } ] },

    { "title": "-1000 aura", "title_color": "#ff5a5a",
      "text": "Moi on m'a dit : t'as des yeux de cochon. En sah, de cochon.",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "moi", "x": 67, "expr": "shocked", "anim": "shake", "bubble": "sweat" } ],
      "fx": ["shake", "flash"] },

    { "text": "Le cochon, il était même pas au courant, frérot.",
      "bg": { "type": "room", "wall": "#f3d9a4" },
      "chars": [ { "id": "moi", "x": 67, "expr": "smirk", "bubble": "question" } ] },

    { "text": "Sur les photos, les yeux bleus brillent comme un fond d'écran d'iPhone.",
      "bg": { "type": "plain", "color": "#bfe3ff" },
      "chars": [ { "id": "bleu", "x": 67, "expr": "happy" } ],
      "props": [ { "type": "photo", "x": 26, "y": 72, "scale": 2, "at_word": 3 },
                 { "type": "eye_blue", "x": 106, "y": 72, "scale": 2, "anim": "blink" } ] },

    { "text": "Moi sur les photos, j'ai deux trous noirs. Vision nocturne activée.",
      "bg": { "type": "night" },
      "chars": [ { "id": "moi", "x": 67, "expr": "neutral", "anim": "none" } ],
      "props": [ { "type": "photo", "x": 32, "y": 110, "scale": 2 } ],
      "fx": ["zoom"] },

    { "text": "Sous ses posts : ses yeux, j'suis morte. Sous les miens : ratio.",
      "bg": { "type": "split", "left": "#bfe3ff", "right": "#e8cfae" },
      "chars": [ { "id": "bleu", "x": 34, "expr": "laugh", "hold": "phone" },
                 { "id": "moi", "x": 100, "expr": "sad", "hold": "phone", "flip": true } ],
      "props": [ { "type": "heart", "x": 22, "y": 70, "scale": 2, "at_word": 3 },
                 { "type": "heart", "x": 48, "y": 62, "scale": 2, "at_word": 5 },
                 { "type": "x", "x": 100, "y": 66, "scale": 3, "at_word": 10 } ] },

    { "text": "Alors j'ai voulu faire mon glow up : lentilles bleues commandées sur Temu.",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "moi", "x": 67, "expr": "happy", "hold": "gift", "anim": "bounce" } ],
      "props": [ { "type": "eye_blue", "x": 67, "y": 64, "scale": 2, "at_word": 7 } ] },

    { "title": "Erreur système", "title_color": "#ff5a5a",
      "text": "Résultat : on dirait un PNJ de jeu vidéo qui a buggé.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "chars": [ { "id": "moi", "x": 67, "expr": "worried", "anim": "shake", "spec": { "eyes": "#3a8de0" } } ],
      "fx": ["shake", "flash"] },

    { "text": "Ma mère m'a vu, elle a cru que j'étais possédé.",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "mere", "x": 40, "expr": "shocked", "anim": "shake" },
                 { "id": "moi", "x": 98, "expr": "neutral", "flip": true, "spec": { "eyes": "#3a8de0" } } ],
      "props": [ { "type": "exclam", "x": 40, "y": 70, "scale": 2 } ] },

    { "text": "Mais attends, plot twist.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "chars": [ { "id": "moi", "x": 67, "expr": "smirk", "anim": "none", "bubble": "bulb" } ],
      "fx": ["zoom"] },

    { "text": "Sept personnes sur dix ont les yeux marron. Les yeux bleus c'est nous les NPC ? Non, c'est eux.",
      "bg": { "type": "room", "wall": "#e8cfae" },
      "chars": [ { "id": "moi", "x": 24, "expr": "happy" },
                 { "id": "fille", "x": 67, "expr": "happy" },
                 { "id": "mere", "x": 110, "expr": "happy", "flip": true } ],
      "props": [ { "type": "check", "x": 67, "y": 66, "scale": 2, "at_word": 6 } ] },

    { "title": "+10 000 aura", "title_color": "#ffd93b",
      "text": "Et au soleil, les yeux marron deviennent couleur miel. Ça s'appelle le mode doré.",
      "bg": { "type": "burst", "color": "#ffe08a", "color2": "#ffd04a" },
      "chars": [ { "id": "moi", "x": 67, "expr": "smirk", "pose": "arms_up", "anim": "jump", "spec": { "eyes": "#c8902a" } } ],
      "props": [ { "type": "eye_honey", "x": 106, "y": 82, "scale": 2, "at_word": 6 },
                 { "type": "star", "x": 24, "y": 90, "anim": "float" } ],
      "fx": ["flash"] },

    { "text": "Team marron ou team bleus ? Dis-le en commentaire. Abonne-toi, la team miel.",
      "bg": { "type": "split", "left": "#bfe3ff", "right": "#e8cfae" },
      "chars": [ { "id": "bleu", "x": 34, "expr": "smirk" },
                 { "id": "moi", "x": 100, "expr": "laugh", "pose": "wave", "flip": true, "spec": { "eyes": "#c8902a" } } ],
      "props": [ { "type": "question", "x": 67, "y": 70, "scale": 2, "anim": "float" } ] }
  ]
