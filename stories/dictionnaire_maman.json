{
  "title": "Ce que ta mère dit vs ce que ça veut dire",
  "header": "Dictionnaire maman -> français",
  "fps": 30,
  "words_per_second": 2.6,
  "captions": { "size": 28, "y": 0.8, "max_words": 2, "highlight": "#ffd93b" },

  "cast": {
    "moi":  { "skin": "medium", "hair": "short", "hair_color": "#2a1a14", "shirt": "#3550a8", "pants": "#232742", "acc": ["hoodie"] },
    "mere": { "skin": "medium", "hair": "bun", "hair_color": "#2a1a14", "shirt": "#38b49a", "pants": "#38b49a", "shoes": "#f39ab4", "acc": ["dress", "earrings"] },
    "pere": { "skin": "medium", "hair": "short", "hair_color": "#2a1a14", "shirt": "#f0f0f0", "pants": "#3d3d55", "acc": ["mustache"] }
  },

  "scenes": [
    { "text": "Ta mère parle une langue secrète. Je vais te la traduire.",
      "bg": { "type": "split", "left": "#ffe08a", "right": "#bfc4d6" },
      "chars": [ { "id": "mere", "x": 34, "expr": "smirk" },
                 { "id": "moi", "x": 100, "expr": "happy", "flip": true, "hold": "book" } ],
      "props": [ { "type": "question", "x": 34, "y": 66, "scale": 2, "at_word": 4 } ],
      "fx": ["flash"] },

    { "title": "Elle dit", "title_color": "#ffffff", "text": "Fais ce que tu veux.",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "mere", "x": 67, "expr": "smirk", "anim": "none" } ] },

    { "title": "Traduction", "text": "Si tu le fais, t'es mort.",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "mere", "x": 67, "expr": "angry", "anim": "shake", "bubble": "anger" } ],
      "fx": ["shake", "flash"] },

    { "title": "Elle dit", "title_color": "#ffffff", "text": "On a à manger à la maison.",
      "bg": { "type": "street" },
      "chars": [ { "id": "moi", "x": 40, "expr": "happy", "hold": "pizza" },
                 { "id": "mere", "x": 98, "expr": "neutral", "flip": true } ] },

    { "title": "Traduction", "text": "Ce soir, c'est pâtes au beurre.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "sad", "anim": "none" } ],
      "props": [ { "type": "pizza", "x": 67, "y": 84, "scale": 3 },
                 { "type": "x", "x": 67, "y": 84, "scale": 3, "at_word": 2 } ] },

    { "title": "Elle dit", "title_color": "#ffffff", "text": "Demande à ton père.",
      "bg": { "type": "room", "wall": "#f3d9a4" },
      "chars": [ { "id": "mere", "x": 67, "expr": "happy", "pose": "wave" } ] },

    { "title": "Traduction", "text": "C'est non. Mais elle veut pas être la méchante.",
      "bg": { "type": "room", "wall": "#f3d9a4" },
      "chars": [ { "id": "mere", "x": 40, "expr": "smirk" },
                 { "id": "pere", "x": 98, "expr": "worried", "flip": true, "bubble": "sweat" } ],
      "props": [ { "type": "x", "x": 67, "y": 64, "scale": 2, "at_word": 1 } ] },

    { "title": "Elle dit", "title_color": "#ffffff", "text": "Je dis rien, hein...",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "mere", "x": 67, "expr": "smirk", "hold": "phone" } ] },

    { "title": "Traduction", "text": "Toute la famille sera au courant avant ce soir.",
      "bg": { "type": "burst", "color": "#ffe08a", "color2": "#ffd04a" },
      "chars": [ { "id": "mere", "x": 67, "expr": "laugh", "hold": "phone", "anim": "bounce" } ],
      "props": [ { "type": "phone", "x": 20, "y": 84, "scale": 2, "at_word": 0 },
                 { "type": "phone", "x": 46, "y": 66, "scale": 2, "at_word": 1 },
                 { "type": "phone", "x": 88, "y": 66, "scale": 2, "at_word": 2 },
                 { "type": "phone", "x": 114, "y": 84, "scale": 2, "at_word": 3 } ] },

    { "title": "Elle dit", "title_color": "#ffffff", "text": "On verra.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "mere", "x": 67, "expr": "neutral", "anim": "none" } ] },

    { "title": "Traduction", "text": "Non.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "props": [ { "type": "x", "x": 67, "y": 150, "scale": 5 } ],
      "fx": ["shake", "flash"] },

    { "title": "Elle dit", "title_color": "#ffffff", "text": "Viens ici deux secondes.",
      "bg": { "type": "room", "wall": "#f2c9a0" },
      "chars": [ { "id": "mere", "x": 40, "expr": "happy", "pose": "wave" },
                 { "id": "moi", "x": 98, "expr": "worried", "flip": true } ] },

    { "title": "Traduction", "text": "Prépare-toi, t'en as pour une heure.",
      "bg": { "type": "night" },
      "chars": [ { "id": "moi", "x": 67, "expr": "sad", "anim": "none", "bubble": "zzz" } ],
      "props": [ { "type": "clock", "x": 67, "y": 80, "scale": 3 } ] },

    { "text": "Mais la plus dangereuse, c'est celle-là.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "chars": [ { "id": "moi", "x": 67, "expr": "shocked", "anim": "shake", "bubble": "sweat" } ],
      "fx": ["zoom"] },

    { "title": "Elle dit", "title_color": "#ffffff", "text": "Je compte jusqu'à trois. Un... deux...",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "mere", "x": 67, "expr": "angry", "anim": "none", "bubble": "anger" } ],
      "fx": ["zoom"] },

    { "text": "Personne n'a jamais su ce qui se passe à trois.",
      "bg": { "type": "night" },
      "chars": [ { "id": "moi", "x": 67, "expr": "worried", "ghost": true, "bubble": "question" } ] },

    { "text": "Écris la phrase de ta mère en commentaire, je la traduis dans la partie deux.",
      "bg": { "type": "split", "left": "#ffe08a", "right": "#bfc4d6" },
      "chars": [ { "id": "mere", "x": 34, "expr": "smirk" },
                 { "id": "moi", "x": 100, "expr": "happy", "pose": "wave", "flip": true, "hold": "book" } ],
      "props": [ { "type": "exclam", "x": 67, "y": 66, "scale": 2, "anim": "float" } ] }
  ]
}
