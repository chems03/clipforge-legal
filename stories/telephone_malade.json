{
  "title": "C'est que chez moi ou tout est à cause du téléphone ?",
  "header": "Dès que t'es malade...",
  "fps": 30,
  "words_per_second": 2.6,
  "captions": { "size": 28, "y": 0.8, "max_words": 2, "highlight": "#ffd93b" },

  "cast": {
    "moi":  { "skin": "medium", "hair": "short", "hair_color": "#2a1a14", "shirt": "#3550a8", "pants": "#232742", "acc": ["hoodie"] },
    "mere": { "skin": "medium", "hair": "bun", "hair_color": "#2a1a14", "shirt": "#38b49a", "pants": "#38b49a", "shoes": "#f39ab4", "acc": ["dress", "earrings"] }
  },

  "scenes": [
    { "text": "C'est que chez moi ou dès que t'es malade, c'est à cause du téléphone ?",
      "bg": { "type": "intro", "text": "C'est que|chez moi ?" },
      "fx": ["flash", "shake"] },

    { "title": "Symptôme", "title_color": "#ffffff",
      "text": "Maman, j'ai mal au ventre.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "sad", "bubble": "sweat" } ],
      "props": [ { "type": "thermometer", "x": 106, "y": 100, "scale": 2 } ] },

    { "title": "Diagnostic", "title_color": "#ffd93b",
      "text": "C'est parce que t'es tout le temps sur ton téléphone.",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "mere", "x": 67, "expr": "angry", "anim": "shake", "bubble": "anger" } ],
      "props": [ { "type": "phone", "x": 24, "y": 110, "scale": 3, "at_word": 6 } ],
      "fx": ["flash"] },

    { "title": "Symptôme", "title_color": "#ffffff",
      "text": "Maman, j'ai mal à la tête.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "worried", "bubble": "sweat" } ] },

    { "title": "Diagnostic", "title_color": "#ffd93b",
      "text": "C'est les ondes. Ça te grille le cerveau.",
      "bg": { "type": "burst", "color": "#ffe08a", "color2": "#ffd04a" },
      "chars": [ { "id": "mere", "x": 67, "expr": "smirk", "hold": "phone" } ],
      "props": [ { "type": "bulb", "x": 24, "y": 104, "scale": 2, "at_word": 4 },
                 { "type": "x", "x": 24, "y": 104, "scale": 2, "at_word": 6 } ] },

    { "title": "Symptôme", "title_color": "#ffffff",
      "text": "Maman, j'ai vomi.",
      "bg": { "type": "room", "wall": "#c9f0c0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "shocked", "anim": "shake", "bubble": "sweat" } ],
      "fx": ["flash"] },

    { "title": "Diagnostic", "title_color": "#ffd93b",
      "text": "Évidemment, tu regardes TikTok la tête à l'envers dans ton lit.",
      "bg": { "type": "night" },
      "chars": [ { "id": "mere", "x": 67, "expr": "angry" } ],
      "props": [ { "type": "phone", "x": 106, "y": 100, "scale": 2, "anim": "blink" } ] },

    { "title": "Symptôme", "title_color": "#ffffff",
      "text": "Maman, je me suis cassé le bras au foot.",
      "bg": { "type": "street" },
      "chars": [ { "id": "moi", "x": 67, "expr": "sad", "pose": "arms_up" } ] },

    { "title": "Diagnostic", "title_color": "#ffd93b",
      "text": "Si t'avais pas ton téléphone dans la poche, ça serait jamais arrivé.",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "mere", "x": 40, "expr": "angry", "anim": "shake" },
                 { "id": "moi", "x": 98, "expr": "shocked", "flip": true, "bubble": "question" } ],
      "fx": ["shake"] },

    { "text": "Même quand il pleut dehors, c'est parce que je reste trop sur mon téléphone.",
      "bg": { "type": "plain", "color": "#7f8aa6" },
      "chars": [ { "id": "moi", "x": 67, "expr": "worried", "anim": "none", "bubble": "question" } ],
      "fx": ["zoom"] },

    { "text": "Et le remède, c'est toujours le même.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "chars": [ { "id": "mere", "x": 67, "expr": "smirk", "hold": "paper", "anim": "none" } ] },

    { "title": "Ordonnance", "title_color": "#5ee07a",
      "text": "Bois de l'eau, pose ton téléphone et va dormir.",
      "bg": { "type": "classroom", "wall": "#e8e2cf" },
      "chars": [ { "id": "mere", "x": 67, "expr": "happy", "hold": "paper" } ],
      "props": [ { "type": "phone", "x": 24, "y": 104, "scale": 2, "at_word": 4 },
                 { "type": "x", "x": 24, "y": 104, "scale": 2, "at_word": 5 },
                 { "type": "zzz", "x": 108, "y": 100, "scale": 2, "at_word": 8 } ] },

    { "title": "Plot twist", "title_color": "#ff5a5a",
      "text": "Pendant ce temps, elle, elle est sur Facebook jusqu'à deux heures du matin.",
      "bg": { "type": "night" },
      "chars": [ { "id": "mere", "x": 67, "expr": "laugh", "hold": "phone", "anim": "bounce" } ],
      "props": [ { "type": "clock", "x": 106, "y": 96, "scale": 2, "at_word": 9 } ],
      "fx": ["flash"] },

    { "text": "Avec le son à fond. Des vidéos de recettes en boucle.",
      "bg": { "type": "night" },
      "chars": [ { "id": "mere", "x": 40, "expr": "love", "hold": "phone" },
                 { "id": "moi", "x": 98, "expr": "angry", "flip": true, "bubble": "zzz" } ],
      "props": [ { "type": "cake", "x": 40, "y": 96, "scale": 2, "at_word": 7 } ] },

    { "text": "Dis-moi en commentaire ce que ta mère met sur le dos du téléphone.",
      "bg": { "type": "split", "left": "#cdd3f0", "right": "#ffe08a" },
      "chars": [ { "id": "moi", "x": 34, "expr": "smirk", "hold": "phone" },
                 { "id": "mere", "x": 100, "expr": "angry", "flip": true } ],
      "props": [ { "type": "question", "x": 67, "y": 70, "scale": 2, "anim": "float" } ] }
  ]
}
