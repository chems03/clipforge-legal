{
  "title": "Ma mère au téléphone vs ma mère avec moi",
  "header": "Maman au tel vs maman avec moi",
  "fps": 30,
  "words_per_second": 2.6,
  "voice": "fr-FR-HenriNeural",
  "captions": { "size": 28, "y": 0.8, "max_words": 2, "highlight": "#ffd93b" },

  "cast": {
    "moi":   { "skin": "light", "hair": "short", "hair_color": "#4a2f1f", "shirt": "#3550a8", "pants": "#232742", "acc": ["hoodie"] },
    "mere":  { "skin": "medium", "hair": "bun", "hair_color": "#2a1a14", "shirt": "#38b49a", "pants": "#38b49a", "shoes": "#f39ab4", "acc": ["dress", "earrings"] },
    "tante": { "skin": "tan", "hair": "long", "hair_color": "#c2452d", "shirt": "#9a6ad6", "pants": "#3a2f5a", "acc": [] },
    "pere":  { "skin": "medium", "hair": "short", "hair_color": "#2a1a14", "shirt": "#f0f0f0", "pants": "#3d3d55", "acc": ["mustache", "glasses"] },
    "soeur": { "skin": "light", "hair": "ponytail", "hair_color": "#e0b040", "shirt": "#f06a6a", "pants": "#2b2f45", "size": 0.8 }
  },

  "scenes": [
    { "text": "Ma mère a deux voix.",
      "bg": { "type": "split", "left": "#ffe08a", "right": "#bfc4d6" },
      "chars": [ { "id": "mere", "x": 34, "expr": "happy", "hold": "phone", "anim": "bounce" },
                 { "id": "mere", "x": 100, "expr": "angry", "anim": "shake" } ],
      "fx": ["flash"] },

    { "text": "La première, c'est celle du téléphone.",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "mere", "x": 67, "expr": "happy", "pose": "wave", "hold": "phone" } ],
      "props": [ { "type": "heart", "x": 40, "y": 95, "anim": "float", "at_word": 3 },
                 { "type": "star", "x": 96, "y": 100, "anim": "float", "at_word": 5 } ] },

    { "text": "Allôôô ma chérie ! Oui oui tout va très bien hamdoulilah !",
      "bg": { "type": "burst", "color": "#ffd6e0", "color2": "#ffc2d1" },
      "chars": [ { "id": "mere", "x": 67, "expr": "laugh", "hold": "phone", "anim": "bounce" } ],
      "props": [ { "type": "heart", "x": 30, "y": 70, "anim": "float" },
                 { "type": "heart", "x": 106, "y": 60, "anim": "float" } ],
      "fx": ["zoom"] },

    { "text": "Elle rigole, elle chante, elle parle comme une présentatrice météo.",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "mere", "x": 44, "expr": "laugh", "hold": "phone", "anim": "bounce" },
                 { "id": "moi", "x": 100, "expr": "worried", "flip": true, "bubble": "question" } ] },

    { "text": "Et là, elle raccroche.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "chars": [ { "id": "mere", "x": 67, "expr": "neutral", "anim": "none" } ],
      "props": [ { "type": "phone", "x": 100, "y": 150, "at_word": 3 } ],
      "fx": ["zoom"] },

    { "text": "Pourquoi ta chambre ressemble à un champ de bataille ?",
      "bg": { "type": "burst", "color": "#f38c8c", "color2": "#f6a9a9" },
      "chars": [ { "id": "mere", "x": 67, "expr": "angry", "anim": "shake", "bubble": "anger" } ],
      "fx": ["shake", "flash"] },

    { "text": "Moi j'ai rien fait, j'étais juste en train de respirer.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "shocked", "pose": "arms_up", "bubble": "sweat" } ] },

    { "text": "Et le pire, c'est quand le téléphone sonne en plein milieu.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "mere", "x": 44, "expr": "angry" },
                 { "id": "moi", "x": 100, "expr": "sad", "flip": true } ],
      "props": [ { "type": "phone", "x": 67, "y": 100, "anim": "blink", "scale": 3, "at_word": 6 } ] },

    { "text": "Ouiii bonjour madame ! Non non vous ne dérangez pas du tout !",
      "bg": { "type": "burst", "color": "#ffe9a8", "color2": "#ffd86b" },
      "chars": [ { "id": "mere", "x": 67, "expr": "laugh", "hold": "phone", "pose": "wave", "anim": "bounce" } ],
      "props": [ { "type": "star", "x": 26, "y": 80, "anim": "float" },
                 { "type": "star", "x": 110, "y": 70, "anim": "float" } ],
      "fx": ["flash"] },

    { "text": "Trois secondes. Elle a changé de personnalité en trois secondes.",
      "bg": { "type": "classroom", "wall": "#e8e2cf" },
      "chars": [ { "id": "moi", "x": 44, "expr": "shocked" },
                 { "id": "soeur", "x": 96, "expr": "shocked", "flip": true } ],
      "props": [ { "type": "clock", "x": 67, "y": 64, "scale": 3, "at_word": 0 } ] },

    { "text": "Mon père, lui, il a compris depuis longtemps.",
      "bg": { "type": "room", "wall": "#f2c9a0" },
      "chars": [ { "id": "pere", "x": 67, "expr": "smirk" } ],
      "props": [ { "type": "tv", "x": 106, "y": 150 } ] },

    { "text": "Quand elle est au téléphone, c'est le moment de demander.",
      "bg": { "type": "room", "wall": "#f2c9a0" },
      "chars": [ { "id": "pere", "x": 40, "expr": "smirk" },
                 { "id": "moi", "x": 96, "expr": "happy", "flip": true, "bubble": "bulb" } ] },

    { "text": "Maman, je peux sortir ce soir ?",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "moi", "x": 40, "expr": "happy", "anim": "bounce" },
                 { "id": "mere", "x": 98, "expr": "laugh", "hold": "phone", "flip": true } ] },

    { "text": "Ouiii bien sûr mon cœur !",
      "bg": { "type": "burst", "color": "#c9f0c0", "color2": "#a8e59a" },
      "chars": [ { "id": "moi", "x": 67, "expr": "laugh", "pose": "arms_up", "anim": "jump" } ],
      "props": [ { "type": "check", "x": 67, "y": 70, "scale": 3 } ],
      "fx": ["flash"] },

    { "text": "Elle a raccroché. Elle a tout oublié.",
      "bg": { "type": "night" },
      "chars": [ { "id": "moi", "x": 67, "expr": "sad", "anim": "none" } ],
      "props": [ { "type": "lock", "x": 67, "y": 80, "scale": 3, "at_word": 3 } ] },

    { "text": "Abonne-toi si ta mère aussi a deux voix.",
      "bg": { "type": "split", "left": "#ffe08a", "right": "#bfc4d6" },
      "chars": [ { "id": "mere", "x": 34, "expr": "happy", "hold": "phone" },
                 { "id": "moi", "x": 100, "expr": "happy", "pose": "wave", "flip": true } ],
      "props": [ { "type": "heart", "x": 67, "y": 70, "scale": 3, "anim": "float" } ] }
  ]
}
