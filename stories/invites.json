{
  "title": "Quand des invités viennent à la maison",
  "header": "Quand des invités viennent à la maison",
  "fps": 30,
  "words_per_second": 2.6,
  "captions": { "size": 28, "y": 0.8, "max_words": 2, "highlight": "#ffd93b" },

  "cast": {
    "moi":    { "skin": "medium", "hair": "short", "hair_color": "#2a1a14", "shirt": "#3550a8", "pants": "#232742", "acc": ["hoodie"] },
    "mere":   { "skin": "medium", "hair": "bun", "hair_color": "#2a1a14", "shirt": "#38b49a", "pants": "#38b49a", "shoes": "#f39ab4", "acc": ["dress", "earrings"] },
    "pere":   { "skin": "medium", "hair": "short", "hair_color": "#2a1a14", "shirt": "#f0f0f0", "pants": "#3d3d55", "acc": ["mustache"] },
    "petit":  { "skin": "medium", "hair": "spiky", "hair_color": "#2a1a14", "shirt": "#e2483f", "pants": "#2b2f45", "size": 0.8 },
    "tante":  { "skin": "tan", "hair": "long", "hair_color": "#7a2e1c", "shirt": "#b05ad6", "pants": "#b05ad6", "shoes": "#f6d36a", "acc": ["dress", "earrings"] },
    "tonton": { "skin": "tan", "hair": "short", "hair_color": "#5b4636", "shirt": "#e0a33c", "pants": "#4a4a5a", "acc": ["beard", "glasses"] }
  },

  "scenes": [
    { "text": "Quand des invités viennent à la maison, tout change.",
      "bg": { "type": "split", "left": "#c9ccd8", "right": "#ffe08a" },
      "chars": [ { "id": "moi", "x": 34, "expr": "neutral", "hold": "controller" },
                 { "id": "mere", "x": 100, "expr": "angry", "flip": true, "anim": "shake" } ],
      "fx": ["flash"] },

    { "text": "La veille, ta mère transforme la maison en hôtel cinq étoiles.",
      "bg": { "type": "burst", "color": "#ffe08a", "color2": "#ffd04a" },
      "chars": [ { "id": "mere", "x": 67, "expr": "angry", "pose": "arms_up", "anim": "bounce" } ],
      "props": [ { "type": "star", "x": 20, "y": 70, "anim": "float", "at_word": 6 },
                 { "type": "star", "x": 50, "y": 50, "anim": "float", "at_word": 7 },
                 { "type": "star", "x": 84, "y": 50, "anim": "float", "at_word": 8 },
                 { "type": "star", "x": 114, "y": 70, "anim": "float", "at_word": 9 } ] },

    { "text": "Le salon ? Interdit toute l'année. Personne n'y a jamais mis les pieds.",
      "bg": { "type": "room", "wall": "#f2c9a0" },
      "chars": [ { "id": "moi", "x": 40, "expr": "worried", "bubble": "question" } ],
      "props": [ { "type": "lock", "x": 96, "y": 120, "scale": 3, "at_word": 2 } ] },

    { "text": "Les beaux verres sortent du placard. Ceux qu'on n'a jamais le droit de toucher.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "chars": [ { "id": "moi", "x": 67, "expr": "shocked", "anim": "none" } ],
      "props": [ { "type": "star", "x": 40, "y": 70, "scale": 2, "anim": "blink" },
                 { "type": "star", "x": 96, "y": 60, "scale": 2, "anim": "blink" } ],
      "fx": ["zoom"] },

    { "text": "Et toi, tu passes l'aspirateur à sept heures du matin.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "sad", "bubble": "zzz" } ],
      "props": [ { "type": "clock", "x": 67, "y": 64, "scale": 3, "at_word": 6 } ] },

    { "text": "Ding dong.",
      "bg": { "type": "burst", "color": "#f38c8c", "color2": "#f6a9a9" },
      "chars": [ { "id": "mere", "x": 40, "expr": "shocked" },
                 { "id": "moi", "x": 98, "expr": "shocked", "flip": true } ],
      "props": [ { "type": "exclam", "x": 67, "y": 60, "scale": 3 } ],
      "fx": ["shake", "flash"] },

    { "text": "Tu dois faire la bise à tout le monde. Même au cousin que t'as jamais vu de ta vie.",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "moi", "x": 24, "expr": "worried", "bubble": "sweat" },
                 { "id": "tante", "x": 67, "expr": "happy", "flip": true },
                 { "id": "tonton", "x": 110, "expr": "happy", "flip": true } ],
      "props": [ { "type": "question", "x": 110, "y": 70, "scale": 2, "at_word": 10 } ] },

    { "text": "Mach'Allah, comme t'as grandi !",
      "bg": { "type": "burst", "color": "#ffd6e0", "color2": "#ffc2d1" },
      "chars": [ { "id": "tante", "x": 67, "expr": "love", "pose": "arms_up", "anim": "bounce" } ],
      "props": [ { "type": "heart", "x": 26, "y": 80, "anim": "float" },
                 { "type": "heart", "x": 108, "y": 70, "anim": "float" } ],
      "fx": ["zoom"] },

    { "text": "Et le bac, ça se passe comment ? Et t'as une copine ?",
      "bg": { "type": "room", "wall": "#f3d9a4" },
      "chars": [ { "id": "tonton", "x": 40, "expr": "smirk" },
                 { "id": "moi", "x": 98, "expr": "shocked", "flip": true, "bubble": "sweat" } ],
      "props": [ { "type": "book", "x": 40, "y": 70, "scale": 2, "at_word": 2 },
                 { "type": "heart", "x": 98, "y": 64, "scale": 2, "at_word": 9 } ] },

    { "text": "Et ta mère répond à ta place : il travaille très bien !",
      "bg": { "type": "room", "wall": "#f3d9a4" },
      "chars": [ { "id": "mere", "x": 40, "expr": "laugh", "anim": "bounce" },
                 { "id": "moi", "x": 98, "expr": "smirk", "flip": true } ],
      "props": [ { "type": "x", "x": 98, "y": 64, "scale": 2, "at_word": 8 } ] },

    { "text": "Pendant ce temps, le petit mange tous les gâteaux.",
      "bg": { "type": "burst", "color": "#c9f0c0", "color2": "#a8e59a" },
      "chars": [ { "id": "petit", "x": 67, "expr": "laugh", "hold": "cake", "anim": "jump" } ],
      "props": [ { "type": "cake", "x": 30, "y": 90, "scale": 2, "at_word": 4 },
                 { "type": "cake", "x": 104, "y": 80, "scale": 2, "at_word": 6 } ] },

    { "text": "Toi, si tu touches un seul gâteau, ta mère te regarde comme ça.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "chars": [ { "id": "mere", "x": 67, "expr": "angry", "anim": "none", "bubble": "anger" } ],
      "fx": ["zoom", "shake"] },

    { "text": "Les invités partent à minuit. Tu crois que c'est fini ?",
      "bg": { "type": "night" },
      "chars": [ { "id": "moi", "x": 67, "expr": "happy", "anim": "bounce" } ],
      "props": [ { "type": "clock", "x": 100, "y": 64, "scale": 2, "at_word": 3 } ] },

    { "text": "Non. Maintenant il faut tout ranger.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "sad", "anim": "none", "bubble": "sweat" } ],
      "props": [ { "type": "cake", "x": 26, "y": 160, "scale": 2 },
                 { "type": "paper", "x": 108, "y": 150, "scale": 2 } ],
      "fx": ["flash"] },

    { "text": "Et ta mère commente tout : t'as vu comment elle était habillée ?",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "mere", "x": 40, "expr": "smirk" },
                 { "id": "pere", "x": 98, "expr": "worried", "flip": true, "bubble": "question" } ] },

    { "text": "Abonne-toi si chez toi aussi le salon est interdit.",
      "bg": { "type": "split", "left": "#c9ccd8", "right": "#ffe08a" },
      "chars": [ { "id": "moi", "x": 34, "expr": "happy", "pose": "wave" },
                 { "id": "mere", "x": 100, "expr": "happy", "flip": true } ],
      "props": [ { "type": "lock", "x": 67, "y": 70, "scale": 3, "anim": "float" } ] }
  ]
}
