{
  "title": "C'est que chez moi ou t'es gentil avec tout le monde sauf tes parents ?",
  "header": "Gentil dehors, à 2% à la maison",
  "fps": 30,
  "words_per_second": 2.6,
  "captions": { "size": 28, "y": 0.8, "max_words": 2, "highlight": "#ffd93b" },

  "cast": {
    "moi":  { "skin": "medium", "hair": "short", "hair_color": "#2a1a14", "shirt": "#3550a8", "pants": "#232742", "acc": ["hoodie"] },
    "pote": { "skin": "tan", "hair": "curly", "hair_color": "#1e1410", "shirt": "#e2483f", "pants": "#2b2f45", "acc": ["cap"] },
    "prof": { "skin": "light", "hair": "short", "hair_color": "#8a8a8a", "shirt": "#6a7a5a", "pants": "#3d3d55", "acc": ["glasses", "beard"] },
    "mere": { "skin": "medium", "hair": "bun", "hair_color": "#2a1a14", "shirt": "#38b49a", "pants": "#38b49a", "shoes": "#f39ab4", "acc": ["dress", "earrings"] }
  },

  "scenes": [
    { "text": "C'est que chez moi ou t'es gentil avec tout le monde, sauf avec tes parents ?",
      "bg": { "type": "intro", "text": "C'est que|chez moi ?" },
      "fx": ["flash", "shake"] },

    { "title": "Batterie 100%", "title_color": "#5ee07a",
      "text": "Avec tes potes, t'es le plus drôle de la bande.",
      "bg": { "type": "street" },
      "chars": [ { "id": "moi", "x": 40, "expr": "laugh", "anim": "bounce" },
                 { "id": "pote", "x": 98, "expr": "laugh", "flip": true, "anim": "bounce" } ],
      "props": [ { "type": "battery_full", "x": 67, "y": 70, "scale": 2 } ] },

    { "text": "Avec ton prof, t'es poli. Avec un inconnu, t'es un ange.",
      "bg": { "type": "classroom", "wall": "#e8e2cf" },
      "chars": [ { "id": "moi", "x": 40, "expr": "happy", "pose": "wave" },
                 { "id": "prof", "x": 98, "expr": "happy", "flip": true } ],
      "props": [ { "type": "star", "x": 40, "y": 92, "scale": 2, "at_word": 9, "anim": "float" } ] },

    { "text": "Et là, tu rentres à la maison.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "chars": [ { "id": "moi", "x": 67, "expr": "neutral", "anim": "walk_in" } ],
      "fx": ["zoom"] },

    { "text": "Ta mère te demande juste : t'as mangé ?",
      "bg": { "type": "room", "wall": "#f3d9a4" },
      "chars": [ { "id": "mere", "x": 40, "expr": "happy", "pose": "wave" },
                 { "id": "moi", "x": 98, "expr": "neutral", "flip": true } ],
      "props": [ { "type": "heart", "x": 40, "y": 92, "scale": 2, "anim": "float" } ] },

    { "text": "Et toi tu soupires comme si elle t'avait demandé de payer le loyer.",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "moi", "x": 67, "expr": "angry", "anim": "shake", "bubble": "anger" } ],
      "props": [ { "type": "money", "x": 24, "y": 104, "scale": 2, "at_word": 10 } ],
      "fx": ["shake"] },

    { "title": "La science", "title_color": "#ffffff",
      "text": "T'es pas un monstre. C'est ton cerveau.",
      "bg": { "type": "plain", "color": "#3a4a7a" },
      "chars": [ { "id": "moi", "x": 67, "expr": "shocked", "bubble": "bulb" } ],
      "fx": ["flash"] },

    { "text": "Des chercheurs de Stanford ont montré que vers treize ans, ton cerveau devient plus attiré par les voix qu'il connaît pas.",
      "bg": { "type": "classroom", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "worried", "spec": { "acc": ["hoodie", "headphones"] } } ],
      "props": [ { "type": "bulb", "x": 24, "y": 104, "scale": 2, "at_word": 8 },
                 { "type": "question", "x": 108, "y": 100, "scale": 2, "at_word": 17 } ] },

    { "text": "Petit, la voix de ta mère, c'était ta playlist préférée.",
      "bg": { "type": "burst", "color": "#ffd6e0", "color2": "#ffc2d1" },
      "chars": [ { "id": "moi", "x": 40, "expr": "love", "spec": { "size": 0.8 } },
                 { "id": "mere", "x": 98, "expr": "happy", "flip": true } ],
      "props": [ { "type": "heart", "x": 67, "y": 92, "scale": 2, "anim": "float" } ] },

    { "text": "Ado, c'est devenu une notification que tu balaies sans la lire.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 67, "expr": "neutral", "hold": "phone" } ],
      "props": [ { "type": "phone", "x": 67, "y": 70, "scale": 3, "at_word": 3 },
                 { "type": "x", "x": 67, "y": 70, "scale": 2, "at_word": 7 } ] },

    { "text": "Elle a pas changé de voix. C'est toi qui l'entends autrement.",
      "bg": { "type": "night" },
      "chars": [ { "id": "mere", "x": 40, "expr": "sad" },
                 { "id": "moi", "x": 98, "expr": "worried", "flip": true } ] },

    { "text": "Et puis ta patience, c'est une batterie. Toute la journée, tu souris, tu te retiens.",
      "bg": { "type": "street" },
      "chars": [ { "id": "moi", "x": 67, "expr": "happy", "bubble": "sweat" } ],
      "props": [ { "type": "battery_full", "x": 24, "y": 100, "scale": 2, "at_word": 6 },
                 { "type": "battery_mid", "x": 110, "y": 100, "scale": 2, "at_word": 12 } ] },

    { "title": "Batterie 2%", "title_color": "#ff5a5a",
      "text": "Le soir, quand tu rentres, il te reste deux pour cent. Et tes parents récupèrent ce qui reste.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "moi", "x": 40, "expr": "angry", "bubble": "zzz" },
                 { "id": "mere", "x": 98, "expr": "sad", "flip": true } ],
      "props": [ { "type": "battery_low", "x": 67, "y": 96, "scale": 2, "anim": "blink" } ] },

    { "text": "En plus, chaque phrase arrive avec tout l'historique.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "chars": [ { "id": "moi", "x": 67, "expr": "worried", "anim": "none" } ],
      "props": [ { "type": "paper", "x": 24, "y": 104, "scale": 2, "at_word": 4 },
                 { "type": "paper", "x": 110, "y": 96, "scale": 2, "at_word": 6 } ],
      "fx": ["zoom"] },

    { "title": "Range ta ch...", "title_color": "#ff5a5a",
      "text": "Range ta chambre ? Mille fois entendu. Alors t'es énervé avant même la fin de la phrase.",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "mere", "x": 40, "expr": "neutral", "pose": "wave" },
                 { "id": "moi", "x": 98, "expr": "angry", "flip": true, "anim": "shake", "bubble": "anger" } ],
      "fx": ["shake"] },

    { "text": "Et en grandissant, on se dispute moins souvent... mais plus fort.",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "mere", "x": 40, "expr": "angry", "anim": "shake" },
                 { "id": "moi", "x": 98, "expr": "angry", "flip": true, "anim": "shake" } ],
      "props": [ { "type": "anger", "x": 67, "y": 96, "scale": 3, "at_word": 7 } ],
      "fx": ["flash"] },

    { "text": "Le pire, c'est qu'eux, ils croient que cette version-là, c'est toi.",
      "bg": { "type": "night" },
      "chars": [ { "id": "mere", "x": 40, "expr": "sad", "anim": "none" },
                 { "id": "moi", "x": 98, "expr": "sad", "flip": true, "anim": "none", "ghost": true } ] },

    { "title": "Batterie 20%", "title_color": "#ffd93b",
      "text": "Alors ce soir, garde-leur un peu de batterie.",
      "bg": { "type": "room", "wall": "#f3d9a4" },
      "chars": [ { "id": "moi", "x": 67, "expr": "happy" } ],
      "props": [ { "type": "battery_mid", "x": 67, "y": 92, "scale": 2 } ] },

    { "text": "Et si ta mère te demande si t'as mangé, réponds gentiment. Bon, elle va croire que t'es malade.",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "moi", "x": 40, "expr": "happy", "pose": "wave" },
                 { "id": "mere", "x": 98, "expr": "shocked", "flip": true } ],
      "props": [ { "type": "thermometer", "x": 98, "y": 92, "scale": 2, "at_word": 16 } ] },

    { "text": "Tague quelqu'un qui garde zéro pour cent pour ses parents.",
      "bg": { "type": "split", "left": "#c9f0c0", "right": "#f6a9a9" },
      "chars": [ { "id": "moi", "x": 34, "expr": "laugh", "spec": { "acc": ["hoodie"] } },
                 { "id": "moi", "x": 100, "expr": "angry", "flip": true } ],
      "props": [ { "type": "battery_full", "x": 34, "y": 80, "scale": 2 },
                 { "type": "battery_low", "x": 100, "y": 80, "scale": 2, "anim": "blink" } ] }
  ]
}
