{
  "title": "Ils nous aiment tous pareil (c'est faux)",
  "header": "Ils nous aiment tous pareil...",
  "fps": 30,
  "words_per_second": 2.6,
  "captions": { "size": 28, "y": 0.8, "max_words": 2, "highlight": "#ffd93b" },

  "cast": {
    "moi":   { "skin": "medium", "hair": "short", "hair_color": "#2a1a14", "shirt": "#3550a8", "pants": "#232742", "acc": ["hoodie"] },
    "soeur": { "skin": "medium", "hair": "ponytail", "hair_color": "#2a1a14", "shirt": "#f07aa0", "pants": "#2b2f45", "shoes": "#ffffff", "size": 0.8 },
    "mere":  { "skin": "medium", "hair": "bun", "hair_color": "#2a1a14", "shirt": "#38b49a", "pants": "#38b49a", "shoes": "#f39ab4", "acc": ["dress", "earrings"] },
    "pere":  { "skin": "medium", "hair": "short", "hair_color": "#2a1a14", "shirt": "#f0f0f0", "pants": "#3d3d55", "acc": ["mustache"] }
  },

  "scenes": [
    { "text": "Mes parents disent qu'ils nous aiment tous pareil.",
      "bg": { "type": "room", "wall": "#f3d9a4" },
      "chars": [ { "id": "pere", "x": 40, "expr": "happy" },
                 { "id": "mere", "x": 96, "expr": "love", "flip": true } ],
      "props": [ { "type": "heart", "x": 67, "y": 70, "scale": 3, "anim": "float" } ],
      "fx": ["flash"] },

    { "text": "Voici les preuves que c'est faux.",
      "bg": { "type": "burst", "color": "#f38c8c", "color2": "#f6a9a9" },
      "chars": [ { "id": "moi", "x": 67, "expr": "smirk", "hold": "paper", "anim": "bounce" } ],
      "fx": ["zoom"] },

    { "title": "Preuve n°1", "text": "Preuve numéro un : les photos.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "props": [ { "type": "photo", "x": 67, "y": 150, "scale": 4, "anim": "float" } ],
      "fx": ["flash"] },

    { "text": "Ma sœur a trois albums de bébé. Moi j'ai une seule photo. Et je suis flou.",
      "bg": { "type": "room", "wall": "#a6dccd" },
      "chars": [ { "id": "soeur", "x": 36, "expr": "laugh", "anim": "bounce" },
                 { "id": "moi", "x": 100, "expr": "sad", "flip": true } ],
      "props": [ { "type": "photo", "x": 18, "y": 70, "scale": 2, "at_word": 3 },
                 { "type": "photo", "x": 40, "y": 60, "scale": 2, "at_word": 4 },
                 { "type": "photo", "x": 62, "y": 70, "scale": 2, "at_word": 5 },
                 { "type": "photo", "x": 108, "y": 66, "scale": 2, "at_word": 9 } ] },

    { "title": "Preuve n°2", "text": "Preuve numéro deux : les cadeaux.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "props": [ { "type": "gift", "x": 67, "y": 150, "scale": 4, "anim": "float" } ],
      "fx": ["flash"] },

    { "text": "Pour son anniversaire, ma sœur a eu un téléphone. Moi j'ai eu une carte avec cinq euros dedans.",
      "bg": { "type": "split", "left": "#ffe08a", "right": "#bfc4d6" },
      "chars": [ { "id": "soeur", "x": 34, "expr": "laugh", "hold": "phone", "anim": "jump" },
                 { "id": "moi", "x": 100, "expr": "worried", "hold": "money" } ] },

    { "title": "Preuve n°3", "text": "Preuve numéro trois : les bêtises.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "props": [ { "type": "x", "x": 67, "y": 150, "scale": 4 } ],
      "fx": ["flash"] },

    { "text": "Ma sœur casse un verre : c'est rien ma chérie !",
      "bg": { "type": "burst", "color": "#ffd6e0", "color2": "#ffc2d1" },
      "chars": [ { "id": "soeur", "x": 40, "expr": "worried" },
                 { "id": "mere", "x": 98, "expr": "love", "flip": true, "bubble": "heart" } ] },

    { "text": "Moi je casse un verre : tu sais combien ça coûte ?!",
      "bg": { "type": "burst", "color": "#e86a6a", "color2": "#f08c8c" },
      "chars": [ { "id": "moi", "x": 40, "expr": "shocked", "bubble": "sweat" },
                 { "id": "mere", "x": 98, "expr": "angry", "flip": true, "anim": "shake", "bubble": "anger" } ],
      "fx": ["shake", "flash"] },

    { "title": "Preuve n°4", "text": "Preuve numéro quatre : le fond d'écran.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "props": [ { "type": "phone", "x": 67, "y": 150, "scale": 4, "anim": "float" } ],
      "fx": ["flash"] },

    { "text": "Sur le téléphone de ma mère, c'est ma sœur en fond d'écran. Moi je suis dans le dossier divers.",
      "bg": { "type": "room", "wall": "#cdd3f0" },
      "chars": [ { "id": "mere", "x": 40, "expr": "love", "hold": "phone" },
                 { "id": "moi", "x": 100, "expr": "sad", "flip": true, "ghost": true } ],
      "props": [ { "type": "photo", "x": 40, "y": 70, "scale": 2, "at_word": 8 },
                 { "type": "question", "x": 100, "y": 66, "scale": 2, "at_word": 15 } ] },

    { "title": "Preuve n°5", "text": "Preuve numéro cinq : les notes.",
      "bg": { "type": "plain", "color": "#2c2f4a" },
      "props": [ { "type": "book", "x": 67, "y": 150, "scale": 4, "anim": "float" } ],
      "fx": ["flash"] },

    { "text": "Ma sœur a eu quatorze : on fête ça au restaurant !",
      "bg": { "type": "burst", "color": "#c9f0c0", "color2": "#a8e59a" },
      "chars": [ { "id": "soeur", "x": 67, "expr": "laugh", "pose": "arms_up", "anim": "jump" } ],
      "props": [ { "type": "trophy", "x": 28, "y": 80, "scale": 2, "at_word": 4 },
                 { "type": "pizza", "x": 106, "y": 70, "scale": 2, "at_word": 7 } ] },

    { "text": "Moi j'ai eu dix-sept : et pourquoi pas vingt ?",
      "bg": { "type": "classroom", "wall": "#e8e2cf" },
      "chars": [ { "id": "moi", "x": 40, "expr": "shocked", "hold": "paper" },
                 { "id": "pere", "x": 98, "expr": "angry", "flip": true } ],
      "fx": ["zoom"] },

    { "text": "Mais bon, ils nous aiment tous pareil. C'est ce qu'ils disent.",
      "bg": { "type": "night" },
      "chars": [ { "id": "moi", "x": 67, "expr": "smirk", "anim": "none" } ] },

    { "text": "Abonne-toi si toi non plus t'es pas le préféré.",
      "bg": { "type": "split", "left": "#ffe08a", "right": "#bfc4d6" },
      "chars": [ { "id": "soeur", "x": 34, "expr": "laugh", "spec": { "acc": ["crown"] } },
                 { "id": "moi", "x": 100, "expr": "happy", "pose": "wave", "flip": true } ],
      "props": [ { "type": "heart", "x": 34, "y": 70, "scale": 2, "anim": "float" } ] }
  ]
}
